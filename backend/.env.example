# WorldMap backend configuration. Copy to backend/.env (setup does this for you).
# Keep real keys out of Git: .env is ignored.

# ── Optional live data ────────────────────────────────────────────────────────

# Vessels and navigation aids — free key at https://aisstream.io
AISSTREAM_API_KEY=

# Road traffic flow tiles — free key at https://developer.tomtom.com
# (50,000 map tiles per day on the free tier)
TOMTOM_API_KEY=

# Flights work anonymously (OpenSky allows ~100 global updates per day that way).
# With a free API client (https://opensky-network.org/my-opensky/account)
# updates run every 30 s instead of every 2 min.
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# ── Server ────────────────────────────────────────────────────────────────────

# 127.0.0.1 keeps the server private to this computer. Use 0.0.0.0:3000 to
# allow other devices on your network (the API has no authentication).
BIND_ADDR=127.0.0.1:3000

# Paths default to <repository>/data and <repository>/frontend/dist.
# DATA_DIR=../data
# FRONTEND_DIR=../frontend/dist

# Allow a different origin to call the API (comma-separated), e.g. a separately hosted UI.
# CORS_ALLOW_ORIGINS=https://maps.example.com

RUST_LOG=info
